<Project InitialTargets="TimeTugFlavourGuard">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Configurations>Debug;CI;Release</Configurations>
    <!-- Libraries and tests are architecture neutral (AnyCPU) so one build runs natively on x64 and ARM64. Only the app picks an architecture. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The self-test and the selftest switch exist only in development and CI builds, never in Release or Store builds. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'CI'">
    <DefineConstants>$(DefineConstants);SELFTEST</DefineConstants>
  </PropertyGroup>

  <!-- The package flavour: Dev (default), Store or Direct (-p:Flavour=Store|Direct; see docs/development.md). The release flavours define STORE or
       DIRECT and are built only in Release, which never defines SELFTEST (the guard below fails any other combination). -->
  <PropertyGroup>
    <Flavour Condition="'$(Flavour)' == ''">Dev</Flavour>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Flavour)' == 'Store'">
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Flavour)' == 'Direct'">
    <DefineConstants>$(DefineConstants);DIRECT</DefineConstants>
  </PropertyGroup>
  <Target Name="TimeTugFlavourGuard">
    <Error Condition="'$(Flavour)' != 'Dev' And '$(Flavour)' != 'Store' And '$(Flavour)' != 'Direct'" Text="Flavour must be Dev, Store or Direct (got '$(Flavour)')." />
    <Error Condition="'$(Flavour)' != 'Dev' And '$(Configuration)' != 'Release'" Text="The $(Flavour) flavour is built with -c Release: only development builds carry the self-test (Debug and CI configurations)." />
  </Target>
</Project>
