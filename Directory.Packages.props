<Project>
  <!-- Central package management. Every version is exact; nothing floats. Record changes in the pull request that makes them. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared engine, from nuget.org (built in binary-companion/timetug-shared). -->
    <PackageVersion Include="TimeTug.Engine" Version="1.7.0" />

    <!-- App -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!-- The Foundation component Microsoft.WindowsAppSDK 2.5.1 depends on (AppNotificationManager), referenced alone by TimeTug.Platform. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <!-- Satisfies the Windows App SDK build targets in the Platform test project (an executable that references the Foundation component). Same version the metapackage requires. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Axe.Windows" Version="2.4.2" />
    <!-- FakeTimeProvider for the tug state machine tests (the package id is ...TimeProvider.Testing; the namespace is Microsoft.Extensions.Time.Testing). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
