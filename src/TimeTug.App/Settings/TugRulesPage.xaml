<UserControl
    x:Class="TimeTug.App.Settings.TugRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Padding="24,24" Spacing="6" MaxWidth="760" HorizontalAlignment="Stretch">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,6" />
      <InfoBar x:Name="MessageBar" Severity="Warning" IsOpen="False" IsClosable="False" />

      <!-- The Enable Tug switch with its hero text -->
      <Grid x:Name="EnableHost">
        <Border x:Name="Hero" CornerRadius="8" Padding="16,14" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Border.Background>
            <SolidColorBrush Color="#1AFF9E1A" />
          </Border.Background>
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="#FFFF9E1A" VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
              <FontIcon Glyph="&#xE945;" FontSize="22" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock x:Name="HeroTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="HeroSubtitle" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ToggleSwitch x:Name="EnableSwitch" Grid.Column="2" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                          Toggled="OnEnableToggled" />
          </Grid>
        </Border>
      </Grid>

      <!-- Timing -->
      <TextBlock x:Name="TimingHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,14,0,2" AutomationProperties.HeadingLevel="Level2" />
      <Grid x:Name="LeadTimeHost">
        <toolkit:SettingsCard x:Name="LeadTimeCard">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE121;" />
          </toolkit:SettingsCard.HeaderIcon>
          <ComboBox x:Name="LeadTimeBox" MinWidth="150" DisplayMemberPath="Title" SelectionChanged="OnLeadTimeChanged" />
        </toolkit:SettingsCard>
      </Grid>

      <!-- Requirements -->
      <TextBlock x:Name="RequirementsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,14,0,2" AutomationProperties.HeadingLevel="Level2" />
      <Grid x:Name="LinkHost">
        <toolkit:SettingsCard x:Name="LinkCard">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE714;" />
          </toolkit:SettingsCard.HeaderIcon>
          <ToggleSwitch x:Name="LinkSwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnLinkToggled" />
        </toolkit:SettingsCard>
      </Grid>
      <Grid x:Name="LinkWarningHost" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,2,0,2">
          <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock x:Name="LinkWarning" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
      <Grid x:Name="AttendeesHost">
        <toolkit:SettingsCard x:Name="AttendeesCard">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE716;" />
          </toolkit:SettingsCard.HeaderIcon>
          <ToggleSwitch x:Name="AttendeesSwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnAttendeesToggled" />
        </toolkit:SettingsCard>
      </Grid>
      <Grid x:Name="AttendeesWarningHost" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,2,0,2">
          <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock x:Name="AttendeesWarning" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- Test -->
      <TextBlock x:Name="TestHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,14,0,2" AutomationProperties.HeadingLevel="Level2" />
      <Grid x:Name="TestHost">
        <toolkit:SettingsCard x:Name="TestCard">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE768;" />
          </toolkit:SettingsCard.HeaderIcon>
          <Button x:Name="TestButton" Click="OnTest" />
        </toolkit:SettingsCard>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
