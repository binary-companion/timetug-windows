<Window
    x:Class="TimeTug.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:TimeTug.Presentation.Settings">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root">
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False" OpenPaneLength="240" SelectionFollowsFocus="Disabled"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.AutoSuggestBox>
        <AutoSuggestBox x:Name="Search" QueryIcon="Find" TextMemberPath="Title" UpdateTextOnSelect="False"
                        TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnQuerySubmitted">
          <AutoSuggestBox.ItemTemplate>
            <DataTemplate x:DataType="settings:SettingsSearchResult">
              <StackPanel Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind PaneTitle}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasPane}" />
              </StackPanel>
            </DataTemplate>
          </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>
      </NavigationView.AutoSuggestBox>
      <ContentPresenter x:Name="PaneHost" />
    </NavigationView>
  </Grid>
</Window>
