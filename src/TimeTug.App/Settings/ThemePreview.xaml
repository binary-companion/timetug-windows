<UserControl
    x:Class="TimeTug.App.Settings.ThemePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="152" Height="96" AutomationProperties.AccessibilityView="Raw">
  <!-- A miniature Settings window in the light theme, the dark theme, or both (Use system). Fixed colours: it shows the option, not the current theme. -->
  <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
    <Grid x:Name="Stage" CornerRadius="8" />
  </Border>
</UserControl>
