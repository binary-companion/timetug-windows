<UserControl
    x:Class="TimeTug.App.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Mac's About content: the hero picture, the lockup, the tagline, the version, the credit and the licence line; plus the Windows copyright and links. -->
  <StackPanel Spacing="14" MaxWidth="460" HorizontalAlignment="Center" Padding="0,12">
    <Border CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            AutomationProperties.AccessibilityView="Raw">
      <Image Source="ms-appx:///Assets/hero.png" Stretch="Uniform" />
    </Border>
    <StackPanel x:Name="Lockup" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
      <Image Source="ms-appx:///Assets/tug-icon.png" Width="56" Height="56" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
    </StackPanel>
    <Border CornerRadius="16" Padding="16,7" HorizontalAlignment="Center" Background="{ThemeResource ControlFillColorSecondaryBrush}">
      <TextBlock x:Name="TaglineText" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>
    <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
    <TextBlock x:Name="CreditText" HorizontalAlignment="Center" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
    <TextBlock x:Name="LicenceText" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
      <HyperlinkButton x:Name="WebsiteLink" Click="OnWebsite" />
      <HyperlinkButton x:Name="LicenceLink" Click="OnLicence" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
  </StackPanel>
</UserControl>
