<UserControl
    x:Class="TimeTug.App.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Padding="36,24" Spacing="12">
      <Button x:Name="BackButton" Click="OnBack" Visibility="Collapsed" HorizontalAlignment="Left" Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE76B;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock x:Name="BackText" />
        </StackPanel>
      </Button>
      <Grid x:Name="HeadingHost">
        <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
      </Grid>
      <StackPanel x:Name="Hub" Spacing="4">
        <toolkit:SettingsCard x:Name="AboutCard" IsClickEnabled="True" Click="OnAbout">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE946;" />
          </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
        <toolkit:SettingsCard x:Name="UpdateCard" IsClickEnabled="True" Click="OnUpdate">
          <toolkit:SettingsCard.HeaderIcon>
            <FontIcon Glyph="&#xE895;" />
          </toolkit:SettingsCard.HeaderIcon>
        </toolkit:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
