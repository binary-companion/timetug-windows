<UserControl
    x:Class="TimeTug.App.Settings.BackdropPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="152" Height="96" AutomationProperties.AccessibilityView="Raw">
  <!-- A miniature flyout on a wallpaper, drawn with the theme's own brushes so it follows the theme being applied. Invented sample cards. -->
  <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
    <Grid CornerRadius="8">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Offset="0" Color="#FF5B8DEF" />
          <GradientStop Offset="0.55" Color="#FF8E5BD9" />
          <GradientStop Offset="1" Color="#FFE8803C" />
        </LinearGradientBrush>
      </Grid.Background>
      <!-- the flyout panel: acrylic over the wallpaper, or flat -->
      <Grid x:Name="Panel" Margin="20,10,20,0" VerticalAlignment="Stretch" CornerRadius="8,8,0,0">
        <Border x:Name="AcrylicFill" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        <Border x:Name="SolidFill" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />
        <Border BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" CornerRadius="8,8,0,0" />
        <StackPanel Spacing="4" Margin="7,6,7,0">
          <Rectangle x:Name="HeaderBar" Height="4" Width="34" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                     Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.7" />
          <Border x:Name="Card1" CornerRadius="5" Padding="5,3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Fill="#FF2E7AF5" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock x:Name="Title1" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                  <Border CornerRadius="5" Background="#FFFFE7C2" Padding="3,0">
                    <TextBlock x:Name="Chip" FontSize="6" FontWeight="SemiBold" Foreground="#FF8A4A00" />
                  </Border>
                </StackPanel>
                <TextBlock x:Name="Details1" FontSize="6.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="Card2" CornerRadius="5" Padding="5,3" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Rectangle Width="2.5" Height="16" RadiusX="1.25" RadiusY="1.25" Fill="#FF34A853" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Title2" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Details2" FontSize="6.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
