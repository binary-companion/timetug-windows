<UserControl
    x:Class="TimeTug.App.Settings.CalendarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Padding="24,24" Spacing="0" MaxWidth="760" HorizontalAlignment="Stretch">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,6" />
      <InfoBar x:Name="MessageBar" Severity="Warning" IsOpen="False" IsClosable="False" Margin="0,0,0,6" />
      <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

      <StackPanel x:Name="EmptyPanel" Spacing="4" Visibility="Collapsed" Margin="0,24,0,24" HorizontalAlignment="Center">
        <TextBlock x:Name="EmptyText" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <HyperlinkButton x:Name="EmptyLink" HorizontalAlignment="Center" Click="OnOpenAccounts" />
      </StackPanel>

      <!-- The sections are built in code: one card per source, the disclosure, then the options. -->
      <StackPanel x:Name="ListPanel" Spacing="0" />

      <TextBlock x:Name="OptionsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,22,0,6" AutomationProperties.HeadingLevel="Level2" />
      <Grid x:Name="SkipHost">
        <toolkit:SettingsCard x:Name="SkipCard">
          <ToggleSwitch x:Name="SkipSwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnSkipToggled" />
        </toolkit:SettingsCard>
      </Grid>
      <Grid x:Name="InferenceHost" Margin="0,4,0,0">
        <toolkit:SettingsCard x:Name="InferenceCard">
          <ToggleSwitch x:Name="InferenceSwitch" MinWidth="0" OnContent="" OffContent="" Toggled="OnInferenceToggled" />
        </toolkit:SettingsCard>
      </Grid>
      <HyperlinkButton x:Name="ForgetButton" Visibility="Collapsed" Click="OnForget" Margin="0,2,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
