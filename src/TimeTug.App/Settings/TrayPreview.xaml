<UserControl
    x:Class="TimeTug.App.Settings.TrayPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="152" Height="64" AutomationProperties.AccessibilityView="Raw">
  <!-- A cropped desktop with the right end of the taskbar: the tray icon as it is drawn, then the system icons and the clock (invented sample, no real data). -->
  <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
    <Grid CornerRadius="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop x:Name="WallTop" Offset="0" Color="#FFA6DEF0" />
          <GradientStop x:Name="WallBottom" Offset="1" Color="#FF0752A6" />
        </LinearGradientBrush>
      </Grid.Background>
      <Border x:Name="Bar" Grid.Row="1" Height="30" Padding="6,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="7">
          <FontIcon x:Name="Chevron" Glyph="&#xE70E;" FontSize="9" />
          <Image x:Name="Icon" Width="20" Height="20" />
          <FontIcon x:Name="Wifi" Glyph="&#xE701;" FontSize="11" />
          <FontIcon x:Name="Volume" Glyph="&#xE767;" FontSize="11" />
          <TextBlock x:Name="Clock" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
