<Window
    x:Class="TimeTug.App.Chip.ChipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The countdown chip: a thin colour bar, the app picture, the meeting's title (trimmed with an ellipsis) and the countdown. Only the root is in the
       accessibility tree (one element named with the whole sentence); the pieces are raw. Texts and colours are set in code from ChipPlan. -->
  <Grid x:Name="Root" Height="32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border x:Name="AccentBar" Grid.Column="0" Width="4" Margin="6,6,0,6" CornerRadius="2" AutomationProperties.AccessibilityView="Raw" />
    <Border x:Name="Icon" Grid.Column="1" Width="18" Height="18" Margin="8,0,8,0" CornerRadius="5" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    <TextBlock x:Name="TitleText" Grid.Column="2" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"
               VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
    <TextBlock x:Name="CountdownText" Grid.Column="3" FontSize="13" TextWrapping="NoWrap" Margin="8,0,14,0" VerticalAlignment="Center"
               AutomationProperties.AccessibilityView="Raw" />
  </Grid>
</Window>
