<UserControl
    x:Class="TimeTug.App.Controls.CalendarListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- The rows are built in code. Their colours come from these styles, so they follow the theme the window is in (a brush looked up in the
         application's resources is the one for the theme Windows was in when the app started, which is wrong once the person chooses another). -->
    <Style x:Key="CalendarCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="CalendarDividerStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="CalendarGroupRowStyle" TargetType="Grid">
      <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="CalendarProblemStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
  </UserControl.Resources>
  <!-- The sections are built in code: the column titles, then one card per source, then (in Settings) the disclosure. -->
  <StackPanel x:Name="ListPanel" Spacing="0" />
</UserControl>
