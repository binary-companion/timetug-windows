<UserControl
    x:Class="TimeTug.App.Controls.AccountsListBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:welcome="using:TimeTug.Presentation.Welcome"
    xmlns:settings="using:TimeTug.App.Settings"
    xmlns:controls="using:TimeTug.App.Controls">
  <UserControl.Resources>
    <!-- A row: the provider glyph, the name, the status in words (with a warning mark when the person is needed), the repeating-events notice, the
         "On this PC" tag and, when the account needs the person, "Sign in again". Its text is decided by the view model. -->
    <DataTemplate x:Key="AccountRowTemplate" x:DataType="welcome:ConnectedAccount">
      <Grid settings:SettingsHighlight.Id="{x:Bind settings:SettingsHighlight.AccountId(ConnectionId)}">
       <Grid ColumnSpacing="12" Padding="4,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind settings:ProviderGlyphs.Of(KindId)}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                  AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" Visibility="{x:Bind NeedsAttention}"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
            <!-- The status is in the warning colour when the person is needed (and the mark before it says so too: never colour alone). -->
            <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" TextWrapping="Wrap" Visibility="{x:Bind controls:RowBinding.Hidden(NeedsAttention)}" />
            <TextBlock Grid.Column="1" Text="{x:Bind StatusText}" TextWrapping="Wrap" Visibility="{x:Bind NeedsAttention}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
          </Grid>
          <Grid ColumnSpacing="6" Visibility="{x:Bind HasNotice}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="{x:Bind NoticeText}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Border CornerRadius="4" Padding="8,2,8,3" VerticalAlignment="Center" Visibility="{x:Bind IsOnThisPc}"
                  Background="{ThemeResource ControlFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw">
            <TextBlock Text="{x:Bind TagText}" Style="{StaticResource CaptionTextBlockStyle}" />
          </Border>
          <Button x:Name="SignInAgainButton" Content="{x:Bind SignInText}" Visibility="{x:Bind CanSignInAgain}"
                  AutomationProperties.Name="{x:Bind SignInAutomationName}" Click="OnRowSignInAgain" Tag="{x:Bind ConnectionId}" />
        </StackPanel>
       </Grid>
      </Grid>
    </DataTemplate>
    <Style x:Key="AccountRowContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Resources>

  <StackPanel Spacing="6">
    <!-- The box: the pinned device row, the list rows (or the empty line) and the "+ -" bar. -->
    <Border x:Name="Box" CornerRadius="8" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Pinned: the account that belongs to this PC. Absent unless Windows lists an account the broker can use. -->
        <Grid x:Name="DevicePanel" Grid.Row="0" Visibility="Collapsed" Padding="16,12" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="DeviceTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DeviceEmail" TextWrapping="Wrap" Visibility="Collapsed" />
            <Grid x:Name="DeviceStatusLine" ColumnSpacing="6" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon x:Name="DeviceStatusIcon" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.AccessibilityView="Raw" />
              <TextBlock x:Name="DeviceStatus" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
            <TextBlock x:Name="DeviceDescription" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
            <Button x:Name="DeviceSignIn" Visibility="Collapsed" Click="OnDeviceSignInAgain" />
            <ToggleSwitch x:Name="DeviceSwitch" OnContent="" OffContent="" MinWidth="0" Toggled="OnDeviceToggled" />
          </StackPanel>
        </Grid>
        <Rectangle x:Name="DeviceDivider" Grid.Row="1" Height="1" Visibility="Collapsed" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- The rows. A tall-enough area so an empty box still looks like a box. -->
        <Grid Grid.Row="2" MinHeight="88">
          <ListView x:Name="List" SelectionMode="Single" ItemTemplate="{StaticResource AccountRowTemplate}"
                    ItemContainerStyle="{StaticResource AccountRowContainer}" Padding="8,4"
                    ContainerContentChanging="OnContainerContentChanging" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" />
          <TextBlock x:Name="EmptyLine" Margin="16,14" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Collapsed"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- The bar: + opens the menu of what can be added, - removes the selected row. -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="8,6">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button x:Name="AddButton" Padding="12,6">
              <FontIcon Glyph="&#xE710;" FontSize="14" />
              <Button.Flyout>
                <MenuFlyout x:Name="AddMenu" Placement="BottomEdgeAlignedLeft" />
              </Button.Flyout>
            </Button>
            <Button x:Name="RemoveButton" Padding="12,6" Click="OnRemoveClick">
              <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Under the box, in this order, each only when it applies. -->
    <StackPanel x:Name="WaitingRow" Orientation="Horizontal" Spacing="12" Margin="2,4,0,0" Visibility="Collapsed">
      <ProgressRing x:Name="WaitingRing" x:Uid="SignInProgress" Width="20" Height="20" IsActive="False" />
      <TextBlock x:Name="WaitingText" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="CancelButton" Click="OnCancel" />
    </StackPanel>
    <StackPanel x:Name="ErrorPanel" Spacing="2" Margin="2,0,0,0" Visibility="Collapsed">
      <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE783;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   AutomationProperties.LiveSetting="Assertive" />
      </Grid>
      <TextBlock x:Name="ErrorDetail" TextWrapping="Wrap" Margin="20,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
    </StackPanel>
    <HyperlinkButton x:Name="BrowserLink" Padding="0" Margin="2,0,0,0" Visibility="Collapsed" Click="OnBrowserLink" />
    <InfoBar x:Name="UnavailableBar" Severity="Warning" IsOpen="False" IsClosable="False" />
    <TextBlock x:Name="WithdrawText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="2,2,0,0"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
