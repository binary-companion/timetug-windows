<UserControl
    x:Class="TimeTug.App.Flyout.ProblemRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One calendar source that needs the person. Colours and texts are set in code from the view model's row. -->
  <Border x:Name="Frame" CornerRadius="10" Padding="10,8" BorderThickness="1">
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon x:Name="Icon" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="Message" Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button x:Name="Action" Grid.Column="2" FontSize="12" Padding="10,3" MinHeight="0" VerticalAlignment="Center" Click="OnActionClick" />
    </Grid>
  </Border>
</UserControl>
