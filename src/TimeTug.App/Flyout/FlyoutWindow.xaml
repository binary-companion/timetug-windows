<Window
    x:Class="TimeTug.App.Flyout.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The tray flyout: problems, header, today's cards, footer. Texts and colours are set in code from FlyoutViewModel. -->
  <Grid x:Name="Root">
    <StackPanel x:Name="Page" HorizontalAlignment="Stretch">
      <StackPanel x:Name="ProblemsPanel" Spacing="6" Margin="12,12,12,0" Visibility="Collapsed" />
      <Grid x:Name="Header" Padding="16,12,16,8" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="HeaderIcon" Width="30" Height="30" CornerRadius="9" AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock x:Name="WeekdayText" FontSize="15" FontWeight="Medium" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="SummaryText" FontSize="12" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="2" Width="28" Height="28" Padding="0" CornerRadius="14" VerticalAlignment="Center" Click="OnSettingsClick">
          <FontIcon Glyph="&#xE713;" FontSize="13" AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </Grid>
      <StackPanel x:Name="NoMorePanel" Orientation="Horizontal" Spacing="6" Margin="16,0,16,8" Visibility="Collapsed">
        <Border x:Name="NoMoreIcon" Width="16" Height="16" CornerRadius="4" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="NoMoreText" FontSize="12" />
      </StackPanel>
      <StackPanel x:Name="EmptyPanel" Spacing="6" Padding="0,22" HorizontalAlignment="Stretch" Visibility="Collapsed">
        <Border x:Name="EmptyIcon" Width="72" Height="72" CornerRadius="16" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptySubtitle" FontSize="13" HorizontalAlignment="Center" />
      </StackPanel>
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
        <StackPanel x:Name="Cards" Spacing="8" Margin="12,4" />
      </ScrollViewer>
      <!-- A merge, unmerge or split that did not go through (the card changed under the person's hand). A live region, so a screen reader says it. -->
      <Border x:Name="NoticePanel" Margin="12,8,12,0" Padding="12,6,6,6" CornerRadius="8" Visibility="Collapsed"
              AutomationProperties.LiveSetting="Polite">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="NoticeDismiss" Grid.Column="1" Width="24" Height="24" Padding="0" CornerRadius="12" Background="Transparent" BorderThickness="0"
                  Click="OnNoticeDismiss">
            <FontIcon Glyph="&#xE711;" FontSize="10" AutomationProperties.AccessibilityView="Raw" />
          </Button>
        </Grid>
      </Border>
      <TextBlock x:Name="FooterText" FontSize="12" Margin="16,8,16,12" />
    </StackPanel>
  </Grid>
</Window>
