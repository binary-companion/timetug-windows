<Window
    x:Class="TimeTug.App.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:welcome="using:TimeTug.Presentation.Welcome"
    xmlns:ctl="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TimeTug.App.Controls">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" Padding="40,28,40,24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsTabStop="False">
      <Grid>
        <!-- Step 1: Welcome to TimeTug. The Windows account listing runs while this is up, so step 2 is ready when it opens. -->
        <StackPanel x:Name="IntroPanel" Spacing="12" Visibility="{x:Bind ViewModel.IsIntroStep, Mode=OneWay}">
          <TextBlock x:Uid="WelcomeTitle" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Uid="WelcomeSubtitle" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Step 2: Connect your calendars: the accounts list, with the Windows account as its first row. Nothing is requested from Windows until Continue. -->
        <StackPanel x:Name="ConnectPanel" Spacing="12" Visibility="{x:Bind ViewModel.IsConnectStep, Mode=OneWay}">
          <TextBlock x:Uid="ConnectCalendarsTitle" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level1" />
          <controls:AccountsListBox x:Name="AccountsBox" Accounts="{x:Bind ViewModel.Accounts}" />
          <TextBlock x:Uid="BrowserNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Step 3: You're connected -->
        <StackPanel x:Name="ConnectedPanel" Spacing="12" Visibility="{x:Bind ViewModel.IsConnectedStep, Mode=OneWay}">
          <TextBlock x:Uid="ConnectedTitle" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level1" />
          <ItemsControl x:Uid="AccountsList" ItemsSource="{x:Bind ViewModel.Accounts.Accounts}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="welcome:AccountRow">
                <Border Padding="16,12" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        AutomationProperties.Name="{x:Bind Summary}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Problem}" Style="{StaticResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind HasProblem}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Bind ViewModel.Accounts.NextMeetingText, Mode=OneWay}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
            <Button x:Name="AddAnotherButton" x:Uid="AddAnother" Command="{x:Bind ViewModel.AddAnotherCommand}" />
            <Button x:Uid="TestTug" Command="{x:Bind ViewModel.Accounts.TestTugCommand}" />
          </StackPanel>
          <!-- Launch at login: unchecked until the person ticks it. Windows decides what comes of the tick. -->
          <StackPanel x:Name="LaunchPanel" Spacing="2" Visibility="{x:Bind ViewModel.ShowLaunchAtLogin, Mode=OneWay}">
            <CheckBox x:Name="LaunchCheck" x:Uid="LaunchAtLoginCheck" Checked="OnLaunchChecked" Unchecked="OnLaunchChecked" />
            <TextBlock x:Name="LaunchNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="28,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <HyperlinkButton x:Name="LaunchLink" Margin="28,0,0,0" Padding="0" Click="OnLaunchLink" Visibility="Collapsed" />
            <TextBlock x:Name="LaunchError" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="28,0,0,0"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
          <Border x:Uid="TrayNoteCard" Padding="16,12" CornerRadius="6" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE7C4;" FontSize="20" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="TrayNoteTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Uid="TrayNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="1">
      <HyperlinkButton x:Name="SkipButton" x:Uid="SkipForNow" Command="{x:Bind ViewModel.SkipCommand}"
                       Visibility="{x:Bind ViewModel.IsConnectStep, Mode=OneWay}" HorizontalAlignment="Left" Padding="0,5" />
      <Button x:Name="GetStartedButton" Content="{x:Bind ViewModel.GetStartedText}" Command="{x:Bind ViewModel.GetStartedCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.GetStartedText}" Style="{StaticResource AccentButtonStyle}"
              Visibility="{x:Bind ViewModel.IsIntroStep, Mode=OneWay}" HorizontalAlignment="Right" MinWidth="96" />
      <Button x:Name="ContinueButton" Content="{x:Bind ViewModel.ContinueText}" Command="{x:Bind ViewModel.ContinueCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.ContinueText}" Style="{StaticResource AccentButtonStyle}"
              Visibility="{x:Bind ViewModel.IsConnectStep, Mode=OneWay}" HorizontalAlignment="Right" MinWidth="96" />
      <Button x:Name="DoneButton" x:Uid="Done" Command="{x:Bind ViewModel.DoneCommand}" Style="{StaticResource AccentButtonStyle}"
              Visibility="{x:Bind ViewModel.IsConnectedStep, Mode=OneWay}" HorizontalAlignment="Right" MinWidth="96" />
    </Grid>
  </Grid>
</Window>
