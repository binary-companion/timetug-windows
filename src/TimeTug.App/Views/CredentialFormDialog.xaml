<ContentDialog
    x:Class="TimeTug.App.Views.CredentialFormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="CredentialDialog"
    DefaultButton="Primary">
  <StackPanel Spacing="12" MinWidth="360">
    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"
             AutomationProperties.LiveSetting="Assertive" />
    <StackPanel x:Name="FieldsPanel" Spacing="10" />
    <TextBlock x:Name="HelpText" TextWrapping="Wrap" Visibility="Collapsed"
               Style="{StaticResource CaptionTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <HyperlinkButton x:Name="HelpLink" Visibility="Collapsed" Padding="0" />
  </StackPanel>
</ContentDialog>
