<Project Sdk="Microsoft.NET.Sdk">
  <!-- The packaged WinUI 3 app (single-project MSIX). Build with -p:Platform=x64 or -p:Platform=ARM64. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>TimeTug.App</RootNamespace>
    <AssemblyName>TimeTug</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\TimeTug.Presentation\TimeTug.Presentation.csproj" />
    <ProjectReference Include="..\TimeTug.Platform\TimeTug.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <!-- The package manifest follows the flavour (-p:Flavour=Dev|Store|Direct): Package.appxmanifest for Dev, Package.<Flavour>.appxmanifest otherwise.
       scripts/release/build-release-msix.ps1 passes -p:ReleaseManifestPath with the Partner Center values and the version filled in. -->
  <!-- Release packages carry their runtimes (docs/spikes/2026-10-store-packaging.md). The .NET runtime is always bundled: a Store customer has no .NET 10
       desktop runtime. The Windows App SDK runtime is bundled in the Direct package (a sideloaded package has no Store to resolve the framework dependency)
       and, in the Store package, only with -p:ReleaseWindowsAppSdkSelfContained=true (the fallback if the Store cannot resolve the dependency). Set here and not
       on the command line: a global property would also reach the class libraries, which refuse it. -->
  <PropertyGroup Condition="'$(Flavour)' != 'Dev'">
    <SelfContained>true</SelfContained>
    <!-- Explicit, so that a build for the other architecture than the machine's (the x64 package from an ARM64 PC) still works. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Flavour)' == 'Direct' Or '$(ReleaseWindowsAppSdkSelfContained)' == 'true'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Flavour)' != 'Dev' And '$(ReleaseManifestPath)' == ''">
    <ReleaseManifestPath>Package.$(Flavour).appxmanifest</ReleaseManifestPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Flavour)' != 'Dev'">
    <AppxManifest Include="$(ReleaseManifestPath)" SubType="Designer" />
  </ItemGroup>
  <!-- The commit this build was made from reaches the app as the SDK's SourceRevisionId (the SDK's built-in Source Link reads it from the git
       repository), which it appends to the informational version ("0.1.0+8060ec0..."); the Software Update page of a development build shows it.
       A build outside a git repository has none. -->
  <!-- Recorded calendar responses and engine files for the self-test: development and CI builds only, never Release. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <EmbeddedResource Include="..\..\tests\data\*.json" LogicalName="TimeTug.SelfTest.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
